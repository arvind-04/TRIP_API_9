<!DOCTYPE html>
<html>
<head>
  <title>Trip Planner</title>
</head>
<body>
  <h1>Plan Your Trip</h1>
  <form action="/itinerary" method="POST">
    <label>City: <input type="text" name="city" value="Jaipur, India" required></label><br>
    <label>Start Date: <input type="date" name="startDate" required></label><br>
    <label>End Date: <input type="date" name="endDate" required></label><br>
    <label>Total Budget: <input type="number" name="budget" value="5000" required></label><br>
    <label>Currency: <input type="text" name="currency" value="INR" required></label><br>
    <button type="submit">Generate Itinerary</button>
  </form>
</body>
</html>
